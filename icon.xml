        android:pathData="M31,39 l4,4 l8,-9 l3,3 l-11,12 l-7,-7 z" />
    <path android:fillColor="#3FB6A8"
        android:pathData="M31,54 l4,4 l8,-9 l3,3 l-11,12 l-7,-7 z" />
